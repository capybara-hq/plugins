  "plugins": [
    {
      "name": "anthropic",
      "version": "0.1.0-rc.0",
      "summary": {
        "en": "Anthropic model provider (model-provider@2) using the official SDK and the native Messages API"
      },
      "homepage": "https://github.com/capybara-hq/plugins/tree/main/plugins/anthropic#readme",
      "permissions": {
        "keys": [
          "config.deployment.secret:apiKey",
          "config.deployment:baseUrl",
          "config.deployment:models",
          "config.deployment:serverFallbacks",
          "permissions.network:api.anthropic.com",
          "provides:model-provider@2"
        ],
        "sensitive": ["config.deployment.secret:apiKey"]
      },
      "source": {
        "npm": {
          "package": "@capybara-hq/plugin-anthropic",
          "version": "0.1.0-rc.0",
