{
  "name": "@capybara-hq/plugin-sandbox-docker",
  "version": "0.1.0",
  "description": "Conversation sandboxes (sandbox@1) as Docker containers (runc or gVisor runsc) behind a Docker socket proxy, with an egress allowlist proxy",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@capybara-hq/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "image",
    "egress-proxy",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@capybara-hq/plugin-sdk": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capybara-hq/testing": "workspace:*",
    "testcontainers": "^12.2.1"
  }
}
