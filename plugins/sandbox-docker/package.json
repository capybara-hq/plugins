{
  "name": "@capybara-hq/plugin-sandbox-docker",
  "version": "0.1.0-rc.14",
  "description": "Conversation sandboxes (sandbox@2) as Docker containers (runc or gVisor runsc) behind a Docker socket proxy: the public network is open by default, with loopback, private, link-local and metadata ranges refused, or a host allowlist per org",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/capybara-hq/plugins.git",
    "directory": "plugins/sandbox-docker"
  },
  "homepage": "https://github.com/capybara-hq/plugins/tree/main/plugins/sandbox-docker#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@capybara-hq/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@capybara-hq/plugin-sdk": "^0.1.0-rc.22",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capybara-hq/plugin-model-fake": "^0.1.0-rc.19",
    "@capybara-hq/testing": "^0.1.0-rc.18",
    "bullmq": "^6.3.15",
    "ioredis": "^6.0.0",
    "kysely": "^0.29.8",
    "testcontainers": "^12.2.1"
  }
}
