      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@capybara-hq/plugin-sdk": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capybara-hq/testing": "workspace:*"
  }
