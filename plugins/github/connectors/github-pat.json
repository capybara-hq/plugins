{
  "displayName": {
    "zh": "GitHub（个人访问令牌）",
    "en": "GitHub (personal access token)"
  },
  "description": "The same GitHub tools as the GitHub template, but each member pastes a personal access token of their own (fine-grained recommended) instead of connecting with OAuth. Off by default: an org admin switches it on where personal access tokens are allowed.",
  "icon": "./icon.svg",
  "defaultEnabled": false,
  "template": {
    "plugin": "connector-mcp",
    "pluginVersion": "^0.1.0-rc.1",
    "connector": "mcp",
    "endpoint": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "X-MCP-Toolsets": "context,repos,issues,pull_requests,users,actions"
      }
    },
    "editableEndpoint": ["url", "headers"],
    "auth": {
      "type": "bearer",
      "ownership": "personal"
    },
    "defaultToolPolicies": {
      "get_me": "allow",
      "get_teams": "allow",
      "get_team_members": "allow",
      "ui_get": "allow",
      "get_commit": "allow",
      "get_file_contents": "allow",
      "get_file_blame": "allow",
      "get_latest_release": "allow",
      "get_release_by_tag": "allow",
      "get_tag": "allow",
      "list_branches": "allow",
      "list_commits": "allow",
      "list_releases": "allow",
      "list_repository_collaborators": "allow",
      "list_tags": "allow",
      "search_code": "allow",
      "search_commits": "allow",
      "search_repositories": "allow",
      "issue_read": "allow",
      "list_issues": "allow",
      "search_issues": "allow",
      "list_issue_types": "allow",
      "list_issue_fields": "allow",
      "get_label": "allow",
      "find_duplicate": "allow",
      "issue_dependency_read": "allow",
      "issue_artifact_read": "allow",
      "pull_request_read": "allow",
      "list_pull_requests": "allow",
      "search_pull_requests": "allow",
      "search_users": "allow",
      "actions_get": "allow",
      "actions_list": "allow",
      "get_job_logs": "allow",
      "create_branch": "ask",
      "create_or_update_file": "ask",
      "push_files": "ask",
      "delete_file": "ask",
      "create_repository": "ask",
      "fork_repository": "ask",
      "create_issue": "ask",
      "issue_write": "ask",
      "add_issue_comment": "ask",
      "update_issue_comment": "ask",
      "sub_issue_write": "ask",
      "add_sub_issue": "ask",
      "remove_sub_issue": "ask",
      "reprioritize_sub_issue": "ask",
      "set_issue_fields": "ask",
      "update_issue_assignees": "ask",
      "update_issue_body": "ask",
      "update_issue_labels": "ask",
      "update_issue_milestone": "ask",
      "update_issue_state": "ask",
      "update_issue_title": "ask",
      "update_issue_type": "ask",
      "issue_dependency_write": "ask",
      "issue_artifact_write": "ask",
      "add_issue_reaction": "ask",
      "add_issue_comment_reaction": "ask",
      "remove_issue_reaction": "ask",
      "remove_issue_comment_reaction": "ask",
      "hide_issue_comment": "ask",
      "unhide_issue_comment": "ask",
      "create_pull_request": "ask",
      "update_pull_request": "ask",
      "update_pull_request_branch": "ask",
      "update_pull_request_body": "ask",
      "update_pull_request_title": "ask",
      "update_pull_request_state": "ask",
      "update_pull_request_draft_state": "ask",
      "merge_pull_request": "ask",
      "request_pull_request_reviewers": "ask",
      "pull_request_review_write": "ask",
      "create_pull_request_review": "ask",
      "submit_pending_pull_request_review": "ask",
      "delete_pending_pull_request_review": "ask",
      "add_comment_to_pending_review": "ask",
      "add_pull_request_review_comment": "ask",
      "add_reply_to_pull_request_comment": "ask",
      "resolve_review_thread": "ask",
      "unresolve_review_thread": "ask",
      "add_pull_request_review_comment_reaction": "ask",
      "remove_pull_request_review_comment_reaction": "ask",
      "hide_pull_request_review": "ask",
      "unhide_pull_request_review": "ask",
      "hide_pull_request_review_comment": "ask",
      "unhide_pull_request_review_comment": "ask",
      "assign_copilot_to_issue": "ask",
      "request_copilot_review": "ask",
      "actions_run_trigger": "ask",
      "delete_repository": "deny"
    }
  }
}
