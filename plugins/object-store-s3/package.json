{
  "name": "@capybara-hq/plugin-object-store-s3",
  "version": "0.1.0-rc.0",
  "description": "Object storage (object-store@1) on any S3-compatible service (AWS S3, MinIO, Ceph, OSS, TOS, ...) using the official @aws-sdk/client-s3",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/capybara-hq/plugins.git",
    "directory": "plugins/object-store-s3"
  },
  "homepage": "https://github.com/capybara-hq/plugins/tree/main/plugins/object-store-s3#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@capybara-hq/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "@aws-sdk/lib-storage": "^3.1154.0",
    "@aws-sdk/s3-presigned-post": "^3.1154.0",
    "@aws-sdk/s3-request-presigner": "^3.1154.0",
    "@capybara-hq/plugin-sdk": "^0.1.0-rc.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capybara-hq/testing": "^0.1.0-rc.3"
  }
}
