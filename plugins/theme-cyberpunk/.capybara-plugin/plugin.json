{
  "$schema": "https://capybarahq.com/schemas/plugin.v1.schema.json",
  "schemaVersion": 1,
  "name": "theme-cyberpunk",
  "displayName": {
    "zh": "赛博朋克",
    "en": "Cyberpunk"
  },
  "version": "0.1.0-rc.10",
  "publisher": "Capybara",
  "icon": "./icon.svg",
  "description": {
    "en": "Cyberpunk theme and UI: neon yellow on deep blue-black, a run-state HUD, scanlines, a boot screen, a glitch CYBERBARA wordmark and opt-in synthesized sound",
    "zh": "赛博朋克主题与界面：深蓝黑底上的霓虹黄，运行状态 HUD、扫描线、启动画面、故障风 CYBERBARA 字标，以及可选的合成音效"
  },
  "homepage": "https://github.com/capybara-hq/plugins/tree/main/plugins/theme-cyberpunk#readme",
  "themes": [
    {
      "path": "./themes/cyberpunk.json"
    }
  ],
  "suggestedAppearance": {
    "theme": "cyberpunk",
    "replacements": {
      "shell.brand": "brand",
      "conversation.empty": "hero"
    }
  }
}
