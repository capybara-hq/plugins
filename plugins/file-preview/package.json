{
  "name": "@capybara-hq/plugin-file-preview",
  "version": "0.1.0-rc.2",
  "description": "Previews code, archives, spreadsheets, documents, PDFs and SVG files in the conversation; entries inside archives are previewed regardless of per-previewer settings",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/capybara-hq/plugins.git",
    "directory": "plugins/file-preview"
  },
  "homepage": "https://github.com/capybara-hq/plugins/tree/main/plugins/file-preview#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@capybara-hq/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "ui"
  ],
  "scripts": {
    "build": "tsc -b",
    "build:ui": "tsx ui-src/build.ts"
  },
  "dependencies": {
    "@capybara-hq/plugin-sdk": "^0.1.0-rc.27"
  },
  "devDependencies": {
    "@capybara-hq/plugin-model-fake": "^0.1.0-rc.28",
    "@capybara-hq/testing": "^0.1.0-rc.22",
    "dompurify": "^3.4.18",
    "esbuild": "^0.28.2",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.3",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "6.5.438",
    "shiki": "^4.6.0"
  }
}
