{
  "displayName": {
    "zh": "Jira",
    "en": "Jira"
  },
  "description": {
    "en": "Read, search and update Jira work items, comments, worklogs, boards and sprints as the connected person, through Atlassian's remote MCP server (Atlassian Cloud). Each member connects their own Atlassian account with OAuth; the client is registered automatically, so no admin setup is needed in Capybara.",
    "zh": "经由 Atlassian 的远程 MCP 服务器（Atlassian Cloud），以连接者本人的身份读取、搜索和更新 Jira 工作项、评论、工时记录、看板和冲刺。每位成员用 OAuth 连接自己的 Atlassian 账号；客户端自动注册，无需在 Capybara 里做任何管理员设置。"
  },
  "icon": "./icons/jira.svg",
  "template": {
    "plugin": "connector-mcp",
    "pluginVersion": "^0.1.0-rc.1",
    "connector": "mcp",
    "endpoint": {
      "url": "https://mcp.atlassian.com/v2/mcp?tools=all"
    },
    "auth": {
      "type": "oauth_code",
      "ownership": "personal",
      "discovery": "mcp",
      "client": "dcr",
      "scopes": [
        "read:jira:agent-interface",
        "write:jira:agent-interface",
        "search:jira:agent-interface",
        "read:me",
        "read:account",
        "offline_access"
      ]
    },
    "defaultToolPolicies": {
      "atlassianUserInfo": "allow",
      "getAccessibleAtlassianResources": "allow",
      "getContentFormatGuide": "allow",
      "discover": "allow",
      "executeRead": "allow",
      "executeWrite": "ask",
      "executeDestructive": "ask",
      "getJiraIssue": "allow",
      "listJiraProjects": "allow",
      "listJiraProjectIssueTypesMetadata": "allow",
      "getJiraIssueTypeMetaWithFields": "allow",
      "listJiraIssueTransitions": "allow",
      "listJiraIssueLinkTypes": "allow",
      "listJiraIssueRemoteIssueLinks": "allow",
      "listJiraIssueWorklogs": "allow",
      "lookupJiraAccountId": "allow",
      "listJiraIssueAssignableUsers": "allow",
      "listJiraIssueComments": "allow",
      "listJiraIssueChangelogs": "allow",
      "getJiraCurrentUser": "allow",
      "getJiraUser": "allow",
      "listJiraStatuses": "allow",
      "listJiraProjectComponents": "allow",
      "getJiraProjectVersions": "allow",
      "getJiraProjectVersionRelatedWork": "allow",
      "listJiraBoards": "allow",
      "getJiraBoardConfig": "allow",
      "getJiraBoardIssueData": "allow",
      "getJiraBoardSprintData": "allow",
      "listJiraBoardSprints": "allow",
      "listJiraFilters": "allow",
      "listJiraDashboards": "allow",
      "getJiraEntityProperty": "allow",
      "downloadJiraIssueAttachment": "allow",
      "searchJiraIssuesUsingJql": "allow",
      "createJiraIssue": "ask",
      "editJiraIssue": "ask",
      "transitionJiraIssue": "ask",
      "addOrEditJiraIssueComment": "ask",
      "addOrEditJiraIssueWorklog": "ask",
      "createJiraIssueLink": "ask",
      "manageJiraProjectVersion": "ask",
      "manageJiraProjectVersionRelatedWork": "ask",
      "manageJiraSprint": "ask",
      "createJiraBoard": "ask",
      "watchJiraIssue": "ask",
      "uploadAttachmentToJiraIssue": "ask",
      "editJiraEntityProperty": "ask",
      "createJiraIssueRemoteIssueLink": "ask",
      "convertJiraIssueHierarchy": "ask"
    }
  }
}
