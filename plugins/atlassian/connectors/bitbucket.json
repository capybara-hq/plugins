{
  "displayName": {
    "zh": "Bitbucket",
    "en": "Bitbucket"
  },
  "description": {
    "en": "Read Bitbucket Cloud repositories, pull requests, pipelines and deployments, and create or review pull requests, as the connected person, through Atlassian's remote MCP server (Atlassian Cloud). Each member connects their own Atlassian account with OAuth; the client is registered automatically, so no admin setup is needed in Capybara. The Bitbucket workspace must be linked to an Atlassian organization.",
    "zh": "经由 Atlassian 的远程 MCP 服务器（Atlassian Cloud），以连接者本人的身份读取 Bitbucket Cloud 的仓库、拉取请求、流水线和部署，并创建或评审拉取请求。每位成员用 OAuth 连接自己的 Atlassian 账号；客户端自动注册，无需在 Capybara 里做任何管理员设置。Bitbucket 工作区必须已关联到 Atlassian 组织。"
  },
  "icon": "./icons/bitbucket.svg",
  "template": {
    "plugin": "connector-mcp",
    "pluginVersion": "^0.1.0-rc.1",
    "connector": "mcp",
    "endpoint": {
      "url": "https://mcp.atlassian.com/v2/mcp?tools=all"
    },
    "auth": {
      "type": "oauth_code",
      "ownership": "personal",
      "discovery": "mcp",
      "client": "dcr",
      "scopes": [
        "read:bitbucket:agent-interface",
        "write:bitbucket:agent-interface",
        "read:me",
        "read:account",
        "offline_access"
      ]
    },
    "defaultToolPolicies": {
      "atlassianUserInfo": "allow",
      "getAccessibleAtlassianResources": "allow",
      "getContentFormatGuide": "allow",
      "discover": "allow",
      "executeRead": "allow",
      "executeWrite": "ask",
      "executeDestructive": "ask",
      "listBitbucketWorkspaces": "allow",
      "getBitbucketWorkspace": "allow",
      "listBitbucketRepositories": "allow",
      "getBitbucketRepository": "allow",
      "getBitbucketRepoDefaultReviewers": "allow",
      "getBitbucketRepoFileContent": "allow",
      "getBitbucketRepoBranch": "allow",
      "getBitbucketRepoCommit": "allow",
      "listBitbucketRepoCommitReports": "allow",
      "getBitbucketRepoCommitReport": "allow",
      "getBitbucketRepoCommitReportAnnotations": "allow",
      "listBitbucketRepoPullRequests": "allow",
      "getBitbucketRepoPullRequest": "allow",
      "getBitbucketRepoPullRequestDiff": "allow",
      "listBitbucketRepoPullRequestComments": "allow",
      "listBitbucketRepoPullRequestTasks": "allow",
      "listBitbucketRepoPipelines": "allow",
      "getBitbucketRepoPipeline": "allow",
      "listBitbucketRepoPipelineSteps": "allow",
      "getBitbucketRepoPipelineStep": "allow",
      "getBitbucketRepoPipelineStepLog": "allow",
      "listBitbucketRepoDeployments": "allow",
      "getBitbucketRepoDeployment": "allow",
      "listBitbucketRepoEnvironments": "allow",
      "getBitbucketRepoEnvironment": "allow",
      "createBitbucketRepoPullRequest": "ask",
      "updateBitbucketRepoPullRequest": "ask",
      "mergeBitbucketRepoPullRequest": "ask",
      "approveBitbucketRepoPullRequest": "ask",
      "requestChangesOnBitbucketRepoPullRequest": "ask",
      "addBitbucketRepoPullRequestComment": "ask",
      "resolveBitbucketRepoPullRequestComment": "ask",
      "reopenBitbucketRepoPullRequestComment": "ask",
      "createBitbucketRepoPullRequestTask": "ask",
      "setBitbucketRepoPullRequestTaskState": "ask",
      "createBitbucketRepoBranch": "ask",
      "createBitbucketRepoCommit": "ask",
      "runBitbucketRepoPipeline": "ask"
    }
  }
}
