{
  "displayName": {
    "zh": "Confluence",
    "en": "Confluence"
  },
  "description": {
    "en": "Read, search, create and edit Confluence pages, blog posts, comments and spaces as the connected person, through Atlassian's remote MCP server (Atlassian Cloud). Each member connects their own Atlassian account with OAuth; the client is registered automatically, so no admin setup is needed in Capybara.",
    "zh": "经由 Atlassian 的远程 MCP 服务器（Atlassian Cloud），以连接者本人的身份读取、搜索、创建和编辑 Confluence 页面、博客文章、评论和空间。每位成员用 OAuth 连接自己的 Atlassian 账号；客户端自动注册，无需在 Capybara 里做任何管理员设置。"
  },
  "icon": "./icons/confluence.svg",
  "template": {
    "plugin": "connector-mcp",
    "pluginVersion": "^0.1.0-rc.1",
    "connector": "mcp",
    "endpoint": {
      "url": "https://mcp.atlassian.com/v2/mcp?tools=all"
    },
    "auth": {
      "type": "oauth_code",
      "ownership": "personal",
      "discovery": "mcp",
      "client": "dcr",
      "scopes": [
        "read:confluence:agent-interface",
        "write:confluence:agent-interface",
        "search:confluence:agent-interface",
        "read:me",
        "read:account",
        "offline_access"
      ]
    },
    "defaultToolPolicies": {
      "atlassianUserInfo": "allow",
      "getAccessibleAtlassianResources": "allow",
      "getContentFormatGuide": "allow",
      "discover": "allow",
      "executeRead": "allow",
      "executeWrite": "ask",
      "executeDestructive": "ask",
      "getConfluenceContent": "allow",
      "listConfluenceContent": "allow",
      "listConfluenceSpaces": "allow",
      "getConfluenceSpace": "allow",
      "getConfluenceSpaceInstructions": "allow",
      "getConfluencePersonalSpace": "allow",
      "listConfluenceComments": "allow",
      "getConfluenceComment": "allow",
      "listConfluenceContentVersions": "allow",
      "getConfluenceContentVersion": "allow",
      "diffConfluenceContentVersions": "allow",
      "listConfluenceAttachments": "allow",
      "getConfluenceAttachment": "allow",
      "downloadConfluenceAttachment": "allow",
      "exportConfluenceContent": "allow",
      "getConfluenceContentPermissions": "allow",
      "getConfluenceContentRestrictionState": "allow",
      "getConfluencePublicLinkStatus": "allow",
      "getConfluenceReactions": "allow",
      "getConfluenceTask": "allow",
      "listConfluenceTasks": "allow",
      "listConfluenceTemplates": "allow",
      "getConfluenceTemplate": "allow",
      "resolveConfluenceContentMacros": "allow",
      "getConfluenceMauiApp": "allow",
      "getConfluenceContentSuggestions": "allow",
      "searchConfluence": "allow",
      "createConfluenceContent": "ask",
      "updateConfluenceContent": "ask",
      "createConfluenceSpace": "ask",
      "setConfluenceSpaceInstructions": "ask",
      "copyConfluenceContent": "ask",
      "moveConfluenceContent": "ask",
      "archiveConfluenceContent": "ask",
      "unarchiveConfluenceContent": "ask",
      "restoreConfluenceContentVersion": "ask",
      "convertConfluenceContentMode": "ask",
      "setConfluenceContentStatus": "ask",
      "createConfluenceComment": "ask",
      "updateConfluenceComment": "ask",
      "updateConfluenceCommentResolution": "ask",
      "createConfluenceAttachment": "ask",
      "addLabelsToConfluenceContent": "ask",
      "addConfluenceReaction": "ask",
      "removeConfluenceReaction": "ask",
      "addConfluenceContentPermissions": "ask",
      "removeConfluenceContentPermissions": "ask",
      "replaceConfluenceContentPermissions": "ask",
      "setConfluenceContentRestrictionState": "ask",
      "enableConfluencePublicLink": "ask",
      "disableConfluencePublicLink": "ask",
      "completeConfluenceTask": "ask",
      "reopenConfluenceTask": "ask",
      "starConfluenceContent": "ask",
      "unstarConfluenceContent": "ask",
      "starConfluenceSpace": "ask",
      "unstarConfluenceSpace": "ask",
      "watchConfluenceContent": "ask",
      "unwatchConfluenceContent": "ask",
      "watchConfluenceSpace": "ask",
      "unwatchConfluenceSpace": "ask",
      "watchConfluenceLabel": "ask",
      "unwatchConfluenceLabel": "ask",
      "addConfluenceContentSuggestions": "ask",
      "createConfluenceInfographicForPage": "ask",
      "editConfluenceInfographicForPage": "ask",
      "createConfluenceMauiApp": "ask",
      "editConfluenceMauiApp": "ask"
    }
  }
}
