{
  "$schema": "https://capybarahq.com/schemas/plugin.v1.schema.json",
  "schemaVersion": 1,
  "name": "atlassian",
  "displayName": {
    "zh": "Atlassian",
    "en": "Atlassian"
  },
  "version": "0.1.0-rc.1",
  "publisher": "Capybara",
  "description": {
    "en": "Agents work with Jira, Confluence and Bitbucket as the connected person, through Atlassian's remote MCP server (Atlassian Cloud). Each member connects their own Atlassian account with OAuth; the client is registered automatically, so the org admin enters nothing",
    "zh": "智能体以连接者本人的身份使用 Jira、Confluence 和 Bitbucket，经 Atlassian 的远程 MCP 服务器（Atlassian Cloud）。每位成员用 OAuth 连接自己的 Atlassian 账号；客户端自动注册，组织管理员无需填写任何内容"
  },
  "icon": "./icon.svg",
  "homepage": "https://github.com/capybara-hq/plugins/tree/main/plugins/atlassian#readme",
  "dependencies": [
    {
      "name": "connector-mcp",
      "version": "^0.1.0-rc.1"
    }
  ],
  "connectorTemplates": [
    {
      "path": "./connectors/jira.json"
    },
    {
      "path": "./connectors/confluence.json"
    },
    {
      "path": "./connectors/bitbucket.json"
    }
  ],
  "setupGuides": [
    {
      "id": "jira-oauth",
      "place": "connector-template",
      "templates": ["jira"]
    },
    {
      "id": "confluence-oauth",
      "place": "connector-template",
      "templates": ["confluence"]
    },
    {
      "id": "bitbucket-oauth",
      "place": "connector-template",
      "templates": ["bitbucket"]
    }
  ]
}
