{
  "schemaVersion": 1,
  "name": "google",
  "displayName": {
    "zh": "Google",
    "en": "Google"
  },
  "version": "0.1.0-rc.1",
  "publisher": "Capybara",
  "icon": "./icon.svg",
  "description": {
    "en": "Sign in with Google (OpenID Connect for Google Workspace accounts, hosted domain enforced on the verified ID token), plus connector templates for Gmail, Google Drive, Calendar, Sheets, Docs, Slides and BigQuery, each member connecting their own Google account",
    "zh": "使用 Google 登录（Google Workspace 账号通过 OpenID Connect 登录，托管域在校验过的 ID token 上强制检查），并提供 Gmail、Google Drive、Calendar、Sheets、Docs、Slides 和 BigQuery 的 connector 模板，每个成员连接自己的 Google 账号"
  },
  "homepage": "https://github.com/capybara-hq/plugins/tree/main/plugins/google#readme",
  "dependencies": [
    {
      "name": "connector-mcp",
      "version": "^0.1.0-rc.1"
    }
  ],
  "connectorTemplates": [
    {
      "path": "./connectors/gmail.json"
    },
    {
      "path": "./connectors/google-drive.json"
    },
    {
      "path": "./connectors/google-calendar.json"
    },
    {
      "path": "./connectors/google-sheets.json"
    },
    {
      "path": "./connectors/google-docs.json"
    },
    {
      "path": "./connectors/google-slides.json"
    },
    {
      "path": "./connectors/bigquery.json"
    }
  ],
  "setupGuides": [
    {
      "id": "google-sign-in",
      "place": "extension-deployment"
    },
    {
      "id": "gmail-oauth",
      "place": "connector-template",
      "templates": ["gmail"]
    },
    {
      "id": "google-drive-oauth",
      "place": "connector-template",
      "templates": ["google-drive"]
    },
    {
      "id": "google-calendar-oauth",
      "place": "connector-template",
      "templates": ["google-calendar"]
    },
    {
      "id": "google-sheets-oauth",
      "place": "connector-template",
      "templates": ["google-sheets"]
    },
    {
      "id": "google-docs-oauth",
      "place": "connector-template",
      "templates": ["google-docs"]
    },
    {
      "id": "google-slides-oauth",
      "place": "connector-template",
      "templates": ["google-slides"]
    },
    {
      "id": "bigquery-oauth",
      "place": "connector-template",
      "templates": ["bigquery"]
    }
  ]
}
