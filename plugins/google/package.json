{
  "name": "@capybara-hq/plugin-google",
  "version": "0.1.0-rc.0",
  "description": "Sign in with Google (identity-source@1 over OpenID Connect with PKCE, the hosted domain enforced on the verified ID token) and connector templates for Google Workspace (Gmail, Drive, Calendar, Sheets, Docs, Slides) and BigQuery",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/capybara-hq/plugins.git",
    "directory": "plugins/google"
  },
  "homepage": "https://github.com/capybara-hq/plugins/tree/main/plugins/google#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@capybara-hq/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@capybara-hq/plugin-sdk": "^0.1.0-rc.52",
    "jose": "^6.2.12",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capybara-hq/plugin-model-fake": "^0.1.0-rc.47",
    "@capybara-hq/testing": "^0.1.0-rc.34"
  }
}
