{
  "displayName": {
    "zh": "Gmail",
    "en": "Gmail"
  },
  "description": {
    "en": "Search and read mail, write drafts and manage labels as the connected person, through Google's Gmail MCP server (Google Workspace Developer Preview). Each member connects their own Google account; an org admin enters the OAuth client of the company's Google Cloud project.",
    "zh": "经由 Google 的 Gmail MCP 服务器（Google Workspace 开发者预览版），以连接者本人的身份搜索和阅读邮件、撰写草稿和管理标签。每位成员连接自己的 Google 账号；组织管理员填入公司 Google Cloud 项目的 OAuth 客户端。"
  },
  "icon": "./icons/gmail.svg",
  "defaultEnabled": false,
  "template": {
    "plugin": "connector-mcp",
    "pluginVersion": "^0.1.0-rc.1",
    "connector": "mcp",
    "endpoint": {
      "url": "https://gmailmcp.googleapis.com/mcp/v1"
    },
    "auth": {
      "type": "oauth_code",
      "ownership": "personal",
      "discovery": "manual",
      "authorizationUrl": "https://accounts.google.com/o/oauth2/v2/auth",
      "tokenUrl": "https://oauth2.googleapis.com/token",
      "client": "manual",
      "tokenAuthMethod": "client_secret_post",
      "scopes": [
        "https://www.googleapis.com/auth/gmail.readonly",
        "https://www.googleapis.com/auth/gmail.compose",
        "https://www.googleapis.com/auth/gmail.modify"
      ],
      "authorizationParams": {
        "access_type": "offline",
        "prompt": "consent"
      }
    },
    "defaultToolPolicies": {
      "create_draft": "ask",
      "list_drafts": "allow",
      "get_draft": "allow",
      "get_thread": "allow",
      "get_message": "allow",
      "search_threads": "allow",
      "label_thread": "ask",
      "unlabel_thread": "ask",
      "apply_sensitive_thread_label": "ask",
      "trash_thread": "ask",
      "untrash_thread": "ask",
      "mark_thread_spam": "ask",
      "unmark_thread_spam": "ask",
      "list_labels": "allow",
      "label_message": "ask",
      "update_message_labels": "ask",
      "unlabel_message": "ask",
      "apply_sensitive_message_label": "ask",
      "trash_message": "ask",
      "untrash_message": "ask",
      "mark_message_spam": "ask",
      "unmark_message_spam": "ask",
      "create_label": "ask"
    }
  }
}
