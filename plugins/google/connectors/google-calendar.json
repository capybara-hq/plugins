{
  "displayName": {
    "zh": "Google 日历",
    "en": "Google Calendar"
  },
  "description": "Find and read events and free time, create, change and answer events as the connected person, through Google's Calendar MCP server (Google Workspace Developer Preview). Each member connects their own Google account; an org admin enters the OAuth client of the company's Google Cloud project.",
  "icon": "./icons/google-calendar.svg",
  "defaultEnabled": false,
  "template": {
    "plugin": "connector-mcp",
    "pluginVersion": "^0.1.0-rc.1",
    "connector": "mcp",
    "endpoint": {
      "url": "https://calendarmcp.googleapis.com/mcp/v1"
    },
    "auth": {
      "type": "oauth_code",
      "ownership": "personal",
      "discovery": "manual",
      "authorizationUrl": "https://accounts.google.com/o/oauth2/v2/auth",
      "tokenUrl": "https://oauth2.googleapis.com/token",
      "client": "manual",
      "tokenAuthMethod": "client_secret_post",
      "scopes": [
        "https://www.googleapis.com/auth/calendar.calendarlist.readonly",
        "https://www.googleapis.com/auth/calendar.events.freebusy",
        "https://www.googleapis.com/auth/calendar.events.readonly",
        "https://www.googleapis.com/auth/calendar.events"
      ],
      "authorizationParams": {
        "access_type": "offline",
        "prompt": "consent"
      }
    },
    "defaultToolPolicies": {
      "list_events": "allow",
      "get_event": "allow",
      "list_calendars": "allow",
      "suggest_time": "allow",
      "create_event": "ask",
      "update_event": "ask",
      "delete_event": "ask",
      "respond_to_event": "ask",
      "search_events": "allow"
    }
  }
}
