{
  "displayName": {
    "zh": "Google 幻灯片",
    "en": "Google Slides"
  },
  "description": "Read presentations, slides and thumbnails and edit presentations as the connected person, through Google's Slides MCP server (Google Workspace Developer Preview). Each member connects their own Google account; an org admin enters the OAuth client of the company's Google Cloud project.",
  "icon": "./icons/google-slides.svg",
  "defaultEnabled": false,
  "template": {
    "plugin": "connector-mcp",
    "pluginVersion": "^0.1.0-rc.1",
    "connector": "mcp",
    "endpoint": {
      "url": "https://slidesmcp.googleapis.com/mcp/v1"
    },
    "auth": {
      "type": "oauth_code",
      "ownership": "personal",
      "discovery": "manual",
      "authorizationUrl": "https://accounts.google.com/o/oauth2/v2/auth",
      "tokenUrl": "https://oauth2.googleapis.com/token",
      "client": "manual",
      "tokenAuthMethod": "client_secret_post",
      "scopes": [
        "https://www.googleapis.com/auth/drive.readonly",
        "https://www.googleapis.com/auth/drive.file",
        "https://www.googleapis.com/auth/presentations.readonly",
        "https://www.googleapis.com/auth/presentations"
      ],
      "authorizationParams": {
        "access_type": "offline",
        "prompt": "consent"
      }
    },
    "defaultToolPolicies": {
      "read_presentation": "allow",
      "read_slide_page": "allow",
      "read_slide_page_thumbnail": "allow",
      "update_presentation": "ask"
    }
  }
}
