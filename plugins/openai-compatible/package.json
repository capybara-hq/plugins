{
  "name": "@capybara-hq/plugin-openai-compatible",
  "version": "0.1.0",
  "description": "Model provider (model-provider@2) for Chat Completions-compatible services (vLLM, DeepSeek, Qwen, ...) using the official openai SDK",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/capybara-hq/core.git",
    "directory": "plugins/openai-compatible"
  },
  "homepage": "https://github.com/capybara-hq/core/tree/main/plugins/openai-compatible#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
