{
  "displayName": {
    "zh": "Slack",
    "en": "Slack"
  },
  "description": "Search, read and send Slack messages, canvases, lists and files as the connected person, through Slack's MCP server. Each member connects their own Slack account; an org admin enters the OAuth client of the company's internal Slack app.",
  "icon": "./icon.svg",
  "defaultEnabled": false,
  "template": {
    "plugin": "connector-mcp",
    "pluginVersion": "^0.1.0-rc.1",
    "connector": "mcp",
    "endpoint": {
      "url": "https://mcp.slack.com/mcp"
    },
    "auth": {
      "type": "oauth_code",
      "ownership": "personal",
      "discovery": "mcp",
      "client": "manual",
      "tokenAuthMethod": "client_secret_post",
      "scopes": [
        "search:read.public",
        "search:read.private",
        "search:read.mpim",
        "search:read.im",
        "search:read.files",
        "search:read.users",
        "channels:history",
        "groups:history",
        "mpim:history",
        "im:history",
        "channels:read",
        "groups:read",
        "mpim:read",
        "im:read",
        "channels:write",
        "groups:write",
        "mpim:write",
        "im:write",
        "chat:write",
        "canvases:read",
        "canvases:write",
        "lists:read",
        "lists:write",
        "files:read",
        "files:write",
        "reactions:read",
        "reactions:write",
        "emoji:read",
        "users:read",
        "users:read.email"
      ]
    },
    "defaultToolPolicies": {
      "slack_search_public": "allow",
      "slack_search_channels": "allow",
      "slack_search_users": "allow",
      "slack_search_emojis": "allow",
      "slack_read_channel": "allow",
      "slack_read_thread": "allow",
      "slack_read_canvas": "allow",
      "slack_read_file": "allow",
      "slack_read_list": "allow",
      "slack_read_user_profile": "allow",
      "slack_list_user_channels": "allow",
      "slack_list_channel_members": "allow",
      "slack_get_reactions": "allow",
      "slack_search_public_and_private": "ask",
      "slack_send_message": "ask",
      "slack_schedule_message": "ask",
      "slack_send_message_draft": "ask",
      "slack_create_conversation": "ask",
      "slack_add_reaction": "ask",
      "slack_create_canvas": "ask",
      "slack_update_canvas": "ask",
      "slack_create_list": "ask",
      "slack_add_list_record": "ask",
      "slack_update_list": "ask",
      "slack_update_list_record": "ask",
      "slack_get_file_upload_url": "ask",
      "slack_complete_file_upload": "ask"
    }
  }
}
