# Slack app manifest for the Capybara Slack plugin (@capybara-hq/plugin-slack), webhook inbound mode.
# Capybara renders this file for a channel connection (setup guide "slack-app"); paste it at
# https://api.slack.com/apps -> Create New App -> From a manifest.
# Reference: https://docs.slack.dev/reference/app-manifest (checked 2026-11-09).
# Webhook mode: Slack posts events, card clicks and slash commands to the connection's webhook
# URL and verifies it when you save; requests are signed with the app's Signing Secret.
display_information:
  # Slack caps app names at 35 characters; shorten it in the app settings if it is longer.
  name: "{{connectionName}}"
  description: Chat with your organization's Capybara agents.
  background_color: "#3d2f24"
features:
  app_home:
    home_tab_enabled: false
    messages_tab_enabled: true
    messages_tab_read_only_enabled: false
  bot_user:
    # Fixed: the bot user's name has the same 35-character cap, and a connection name may be longer.
    display_name: capybara
    always_online: true
  # Slack rejects a message starting with an unregistered "/name", so the kernel's commands are
  # registered here. The plugin turns each into the text the kernel parses: /new -> "/new",
  # /env x -> "/env x", /capybara foo bar -> "/foo bar" (skill invocation).
  slash_commands:
    - command: /new
      url: "{{webhookUrl}}"
      description: Start a new conversation (direct message)
      should_escape: false
    - command: /env
      url: "{{webhookUrl}}"
      description: List or set your default environment (direct message)
      usage_hint: "[name]"
      should_escape: false
    - command: /capybara
      url: "{{webhookUrl}}"
      description: Run a skill
      usage_hint: "<skill> [args]"
      should_escape: false
oauth_config:
  # Sign in with Slack (identity-source@1): <http.publicUrl>/api/v1/auth/sso/slack/callback. The
  # sign-in flow requests openid / email / profile itself; they are not app scopes.
  redirect_urls:
    - "{{signInCallbackUrl}}"
  scopes:
    bot:
      - chat:write # post and update replies and cards
      - commands # slash commands /new, /env, /capybara
      - im:write # conversations.open: tell the bot's own DM from other DMs a slash command runs in
      - im:history # message.im: direct messages to the bot
      - app_mentions:read # app_mention: @capybara in channels
      - channels:history # message.channels: thread replies in public channels
      - groups:history # message.groups: thread replies in private channels
      - users:read # users.info (name, avatar, time zone, locale); team_join / user_change; users.list
      - users:read.email # directory@1: email addresses in users.list (the bot itself does not use it)
settings:
  event_subscriptions:
    request_url: "{{webhookUrl}}"
    bot_events:
      - message.im
      - app_mention
      - message.channels
      - message.groups
      - team_join
      - user_change
  interactivity:
    is_enabled: true
    request_url: "{{webhookUrl}}"
  socket_mode_enabled: false
  org_deploy_enabled: false
  token_rotation_enabled: false
