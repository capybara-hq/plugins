{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "composite": false,
    "incremental": false,
    "types": ["node"]
  },
  "include": ["**/test/**/*.ts", "vitest.config.ts", "vitest.setup.ts", "commitlint.config.ts"],
  "exclude": [
    "node_modules",
    "**/dist",
    "plugins/file-preview/test/app-shell.test.ts",
    "plugins/memory/test",
    "plugins/theme-cyberpunk/test"
  ]
}
